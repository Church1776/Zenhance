function shcolors {

  if [[ -z $ink ]]; then
    echo ":[info]: No colors found."
    return
  fi
  echo "Colors loaded:"
  for (( i = 0; i < 255; i++ )); do
    color="$i"
    echo -e "${ink[$color]}Color Code: $color${ink[reset]}"
  done
  echo ""
}